{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@agents-everywhere/harness",
  "description": "The runner a control plane's install command puts on a machine: checks in, runs the engine, reports back.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": "./src/*.ts",
    "./bundle": "./script/bundle.ts"
  },
  "scripts": {
    "build": "bun run script/bundle.ts",
    "test": "bun test --timeout 10000",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
