{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@agents-everywhere/control",
  "description": "A self-hosted control plane for agents-everywhere: create agents, install them on machines, watch and steer their runs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/cli.ts",
    "./server": "./src/server.ts",
    "./assets": "./script/assets.ts",
    "./conformance": "./test/conformance/suite.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@agents-everywhere/core": "workspace:*",
    "@agents-everywhere/harness": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
