  "globalEnv": ["CI", "AGENTS_EVERYWHERE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "AGENTS_EVERYWHERE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
